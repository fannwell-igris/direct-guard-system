// Company Management & Tracking System
// Database schema
// Covers: Clients, Sites, Employees, Contracts (Client + Employee),
// Invoices, Payments, Operational Costs, the Payroll schema (models only —
// Payroll API/frontend NOT YET BUILT), and Phase 1 Operations models
// (Shift Types, Site Requirements, Roster) — see PROJECT_HANDOFF.md.
// NOT yet included: Users & Permissions, Audit Log (non-payroll), Alerts
// config, Settings. These are deferred to a later module per the
// module-by-module build rule.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ---------- ENUMS ----------

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ContractStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  INACTIVE
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  // Added 2026-09-25, per explicit instruction: an employee who deserted
  // a site and stopped showing up, typically along with company property
  // (uniforms, equipment) that was never returned. Distinct from
  // TERMINATED (a normal, managed exit) so alerts.service.ts can flag
  // their still-assigned InventoryItems immediately rather than waiting
  // on the normal 7-day "taken home" overdue threshold.
  ABSCONDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum BillingFrequency {
  MONTHLY
  QUARTERLY
  ANNUALLY
  ONE_OFF
}

enum PayrollStatus {
  DRAFT
  REVIEWED
  FINALIZED
  PAID
}

enum PayrollPaymentStatus {
  PENDING
  PAID
}

// CURRENT_PERIOD: an early payment of THIS pay period's wages (e.g. the
// boss hands a guard cash before that month's payroll run) — settled in
// full, automatically, the moment payroll for that period is generated,
// so the employee isn't shown as still owing/unpaid. repaymentMonths is
// forced to 1 for this type; it is never spread across future runs.
// LOAN: the original behavior — a cash advance repaid over
// `repaymentMonths` future payroll periods via `monthlyDeduction`. Left
// exactly as it was; only entered/settled manually via the deductions UI.
enum SalaryAdvanceType {
  CURRENT_PERIOD
  LOAN
}

// PERCENTAGE: rate is a fraction (e.g. 0.05 = 5%) applied to relevant pay.
// FIXED: rate is a flat currency amount.
// BRACKETED: progressive/tiered rule (e.g. PAYE); the `config` JSON field on
// StatutoryRule holds the bracket definitions. Kept generic so a rate-table
// engine can be built later without another schema change.
enum StatutoryRuleType {
  PERCENTAGE
  FIXED
  BRACKETED
}

// How an employee's contract compensates them. Determines which fields on
// EmployeeContract / PayrollLineItem are used — see those models below.
// Security officers are paid per shift/day, NOT per hour: there is
// deliberately no hourly-rate or overtime-hours concept anywhere in this
// schema for SHIFT-paid employees.
enum PayType {
  SHIFT
  MONTHLY
}

// SCHEDULED: normal roster entry. CANCELLED: the shift was removed from the
// roster after being scheduled (e.g. site closed that day) — kept instead
// of deleting the row, so the roster history isn't silently rewritten.
enum RosterEntryStatus {
  SCHEDULED
  CANCELLED
}

// Review workflow for a daily OperationsRecord (Section 3/19 of the
// 2026-09-10 scope document — operations staff submit, a reviewer
// approves/rejects, same shape as the Payroll Draft->Reviewed workflow).
enum OperationsReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// Per-employee, per-shift attendance outcome (Section 6 of the 2026-09-10
// scope document). Deliberately does NOT include an "unpaid"/"paid"
// concept here — payroll treatment of each status is a configurable
// company rule (Section 6: "Do not automatically assume every absence is
// unpaid"), decided in the Payroll module, not baked into this enum.
enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  APPROVED_ABSENCE
  REPLACEMENT
  EXTRA_SHIFT
  OTHER
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
  CRITICAL
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
  OVERDUE
}

enum DepartmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}
// ---------- CORE MODELS ----------

model Client {
  id          String   @id @default(uuid())
  name        String
  location    String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  status      RecordStatus @default(ACTIVE)
  dateAdded   DateTime @default(now())
  lastUpdated DateTime @updatedAt

  sites             Site[]
  employees         Employee[]
  clientContracts   ClientContract[]
  invoices          Invoice[]
  payments          Payment[]
   operationalCosts  OperationalCost[]
  payrollRuns       PayrollRun[]
  rosterEntries     RosterEntry[]
  operationsRecords OperationsRecord[]
  marketingActivities MarketingActivity[]
  fieldVisits         FieldVisit[]
  quotations          Quotation[]

  @@map("clients")
}

model Site {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
    siteCoverage  SiteCoverage[]

  siteName    String
  location    String?
  status      RecordStatus @default(ACTIVE)
  notes       String?
  dateAdded   DateTime @default(now())
  lastUpdated DateTime @updatedAt

  employees         Employee[]
  clientContracts   ClientContract[]
  invoices          Invoice[]
  operationalCosts  OperationalCost[]
  inventoryItems    InventoryItem[]
  payrollRuns       PayrollRun[]
  siteRequirements  SiteRequirement[]
  rosterEntries     RosterEntry[]
  operationsRecords OperationsRecord[]
  fieldReceiptEntries FieldReceiptEntry[]
  quotations          Quotation[]

  @@map("sites")
}

model Employee {
  id                String   @id @default(uuid())
  fullName          String
  // Human-facing staff/payroll reference number (e.g. "MSL0043"), as printed
  // on payslips. Free-text, not auto-formatted — the four group companies
  // use different prefixes (Magen Security, Direct Guard, Cheetah Logistics,
  // Ancient Builders), so no single scheme is enforced here. Optional
  // because existing employees won't have one until assigned.
  employeeNumber    String?  @unique
  position          String?
  phone             String?
  salary            Decimal? @db.Decimal(12, 2)

  // Filename only (e.g. "3f2a...-1726400000000.jpg"), NOT the file bytes
  // and NOT a full path - the actual file lives on disk under
  // backend/uploads/employee-photos/, served through the authenticated
  // GET /api/employees/:id/photo endpoint rather than a public static
  // folder, so it inherits the same Employees permission rule as
  // everything else (see middleware/permissions.ts). Added 2026-09-15.
  photoFilename     String?

  contractStartDate DateTime?
  contractEndDate   DateTime?

  assignedClientId  String?
  assignedClient    Client?  @relation(fields: [assignedClientId], references: [id], onDelete: SetNull)
  departmentId      String?
  department        Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  assignedSiteId    String?
  assignedSite      Site?    @relation(fields: [assignedSiteId], references: [id], onDelete: SetNull)

  employmentStatus  EmploymentStatus @default(ACTIVE)

  // Statutory registration flags, informed by a real wage-bill example
  // (2026-09-10) — NAPSA/NHIMA deductions only apply to registered
  // employees ("Y reg. only" per that sheet). Person-level attributes,
  // not contract-level — registration status doesn't change per contract.
  napsaRegistered   Boolean  @default(false)
  nhimaRegistered   Boolean  @default(false)

  // Personal contact details — added 2026-09-28
  email             String?
  address           String?

  // Next of kin — emergency contact details
  nextOfKinName         String?
  nextOfKinRelationship String?
  nextOfKinPhone        String?

  notes             String?
  dateAdded         DateTime @default(now())
  lastUpdated       DateTime @updatedAt

  employeeContracts EmployeeContract[]
  payrollLineItems  PayrollLineItem[]
  rosterEntries     RosterEntry[]
  attendanceRecords AttendanceRecord[] @relation("AttendanceRecordEmployee")
  replacementFor    AttendanceRecord[] @relation("AttendanceRecordReplacementFor")
    payrollProfile  EmployeePayrollProfile?
  salaryAdvances  SalaryAdvance[]
  employeeLoans   EmployeeLoan[]
  payslipRecords  PayslipRecord[]

  tasks             Task[]
    inventoryItems       InventoryItem[]
  stockMovementsIssued StockMovement[]
  takeHomeLogs         ItemTakeHomeLog[]

  // Back-relation for the optional User.employeeId link (RBAC row-level
  // filtering). Optional 1:1 - most Employees will NOT have a User account.
  user                 User?
  @@map("employees")
}

model ClientContract {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)

  siteId        String?
  site          Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)

  startDate     DateTime
  endDate       DateTime
  amount        Decimal  @db.Decimal(12, 2)
  billingFrequency BillingFrequency @default(MONTHLY)

  // Status is calculated by the application layer from startDate/endDate
  // and configurable thresholds (see Settings, not yet built). Stored here
  // as a cached value so it can be indexed/queried efficiently.
  status        ContractStatus @default(ACTIVE)

  notes         String?
  dateCreated   DateTime @default(now())
  lastUpdated   DateTime @updatedAt

  @@map("client_contracts")
}

model EmployeeContract {
  id            String   @id @default(uuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  startDate     DateTime
  endDate       DateTime

  // How this contract pays the employee. Validation (in the application
  // layer, not the DB) enforces: MONTHLY requires `salary`; SHIFT requires
  // `shiftRate` (and treats `extraShiftRate` as optional, defaulting to
  // `shiftRate` when null). Deliberately no hourly-rate field anywhere.
  payType        PayType  @default(MONTHLY)
  salary         Decimal? @db.Decimal(12, 2) // required when payType = MONTHLY
  shiftRate      Decimal? @db.Decimal(12, 2) // required when payType = SHIFT
  extraShiftRate Decimal? @db.Decimal(12, 2) // optional override; defaults to shiftRate

  status        ContractStatus @default(ACTIVE)

  notes         String?
  dateCreated   DateTime @default(now())
  lastUpdated   DateTime @updatedAt

  payrollLineItems PayrollLineItem[]

  @@map("employee_contracts")
}

model Invoice {
  id             String   @id @default(uuid())
  invoiceNumber  String   @unique

  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)

  siteId         String?
  site           Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)

  invoiceDate    DateTime
  billingPeriod  String?
  dueDate        DateTime

  amount         Decimal  @db.Decimal(12, 2)

  // amountPaid and outstandingBalance are derived from the related Payments
  // and should be recalculated by the application layer whenever a payment
  // is recorded/edited/deleted. Cached here for fast reads/reporting.
  amountPaid          Decimal @default(0) @db.Decimal(12, 2)
  outstandingBalance  Decimal @db.Decimal(12, 2)

  status         InvoiceStatus @default(DRAFT)
  notes          String?
  dateCreated    DateTime @default(now())
  lastUpdated    DateTime @updatedAt

  payments       Payment[]

  @@map("invoices")
}

model Payment {
  id            String   @id @default(uuid())

  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)

  paymentDate   DateTime
  amount        Decimal  @db.Decimal(12, 2)
  paymentMethod String?
  reference     String?
  notes         String?
  dateCreated   DateTime @default(now())

  @@map("payments")
}

model OperationalCost {
  id           String   @id @default(uuid())

  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)

  siteId       String
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Restrict)

  month        DateTime // stored as the 1st day of the relevant month
  costCategory String   // free text for now; move to a lookup table when Settings module is built
  amount       Decimal  @db.Decimal(12, 2)
  description  String?
  date         DateTime @default(now())
  notes        String?

  @@map("operational_costs")
}

// ---------- PAYROLL MODELS ----------
// Added to the schema ahead of the Payroll API/frontend so the Employee and
// EmployeeContract models don't need to be re-shaped later. NOT YET BUILT —
// see PROJECT_HANDOFF.md "Not Yet Built". Build order: this module depends
// on Employees existing as a working API, so it comes after Employees, not
// necessarily after every other module.
//
// Design notes:
// - PayrollLineItem is a SNAPSHOT of an employee's pay for one month, not a
//   live join against Employee/EmployeeContract. If an employee's salary
//   changes next month, past payroll runs must NOT change retroactively.
// - Allowances/deductions are itemized in their own tables (rather than one
//   JSON blob) so the "Deductions" and per-type breakdowns in the Excel
//   workbook/reports can be queried directly.
// - Statutory rates (PAYE/NAPSA/NHIMA) are configurable via StatutoryRule
//   rather than hard-coded, per the "rules engine" requirement — the
//   `config` JSON field allows a bracketed/progressive rule (like PAYE)
//   without needing a schema change if brackets are added later.
// - clientId/siteId on PayrollRun are optional: a payroll run can be
//   company-wide, or scoped to a single client/site for wage-cost-vs-margin
//   reporting. The app layer (not a DB constraint) should prevent creating
//   two runs for the same period + client + site combination, consistent
//   with this project's "validation done by hand" decision.
// - Shift-based pay fields (below) are all optional and only populated for
//   SHIFT-paid employees. `basicSalary` still holds the base pay figure for
//   both pay types (salary for MONTHLY, computed normal-shift pay for
//   SHIFT) so no existing field had to be made nullable. The pre-existing
//   `overtime` field is never used for SHIFT employees — extra-shift pay is
//   tracked separately in `extraShiftPay`, per the "no overtime hours"
//   business rule.

model AllowanceType {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  dateCreated DateTime @default(now())
  lastUpdated DateTime @updatedAt

  allowances  PayrollAllowance[]

  @@map("allowance_types")
}

model DeductionType {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  dateCreated DateTime @default(now())
  lastUpdated DateTime @updatedAt

  deductions  PayrollDeduction[]
  statutoryRules StatutoryRule[]

  @@map("deduction_types")
}

// Configurable statutory contribution rules (PAYE, NAPSA, NHIMA, or any
// future statutory requirement) with an effective date range, so a rate
// change doesn't overwrite the rate that applied to already-finalized
// payroll runs.
model StatutoryRule {
  id            String            @id @default(uuid())
  name          String            // e.g. "NAPSA", "NHIMA", "PAYE"
  description   String?
  ruleType      StatutoryRuleType

  // Which DeductionType this rule posts amounts against when applied to a
  // payroll run. Also used by the eligibility check (isEligibleForRule) to
  // identify NAPSA/NHIMA rules by their linked DeductionType's name, since
  // there's no separate category enum here.
  deductionTypeId String
  deductionType   DeductionType @relation(fields: [deductionTypeId], references: [id], onDelete: Restrict)

  // Used when ruleType is PERCENTAGE or FIXED. Null when BRACKETED (use
  // `config` instead). Percentage stored as a fraction (0.05 = 5%).
  employeeRate  Decimal? @db.Decimal(9, 6)
  employerRate  Decimal? @db.Decimal(9, 6)

  // Bracket/tier definitions for BRACKETED rules (e.g. PAYE tax bands).
  // Left as freeform JSON so bracket structure can evolve without a
  // migration; the calculation engine that reads this is part of the
  // (not yet built) Payroll module, not the schema.
  config        Json?

  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean  @default(true)
  notes         String?
  dateCreated   DateTime @default(now())
  lastUpdated   DateTime @updatedAt

  @@map("statutory_rules")
}

model PayrollRun {
  id       String   @id @default(uuid())

  // Stored as the 1st day of the relevant month, matching the convention
  // already used by OperationalCost.month.
  period   DateTime

  clientId String?
  client   Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  siteId   String?
  site     Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)

  status   PayrollStatus @default(DRAFT)

  // Cached totals recalculated by the application layer whenever a line
  // item changes, same pattern as Invoice.amountPaid/outstandingBalance.
  totalGrossPay      Decimal @default(0) @db.Decimal(14, 2)
  totalDeductions    Decimal @default(0) @db.Decimal(14, 2)
  totalNetPay        Decimal @default(0) @db.Decimal(14, 2)

  // Who did what, for the Draft -> Reviewed -> Finalized -> Paid trail.
  // Free-text user identifier for now since Users & Permissions doesn't
  // exist yet; revisit as a proper relation once that module is built.
  createdBy    String?
  reviewedBy   String?
  finalizedBy  String?
  paidBy       String?

  reviewedAt   DateTime?
  finalizedAt  DateTime?
  paidAt       DateTime?

  notes        String?
  dateCreated  DateTime @default(now())
  lastUpdated  DateTime @updatedAt

  lineItems    PayrollLineItem[]
  auditLogs    PayrollAuditLog[]
  payslipRecords  PayslipRecord[]

  @@map("payroll_runs")
}

model PayrollLineItem {
  id               String   @id @default(uuid())
  payslipRecord   PayslipRecord?

  payrollRunId     String
  payrollRun       PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  employeeId       String
  // Restrict, not Cascade: an employee with payroll history can't be
  // hard-deleted, consistent with the project's financial-history rule
  // (Section 19) already applied to EmployeeContract/Invoice/Payment.
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  // Which contract the salary/rate snapshot was sourced from, kept for
  // traceability. Optional + SetNull because the contract itself may later
  // be edited/superseded without invalidating this historical line item.
  employeeContractId String?
  employeeContract    EmployeeContract? @relation(fields: [employeeContractId], references: [id], onDelete: SetNull)

  // Snapshotted at the time the run is generated, so a later name/position
  // change on the Employee record doesn't rewrite historical payslips.
  fullNameSnapshot String
  positionSnapshot String?

  // Base pay for the period: the salary snapshot for MONTHLY employees, or
  // the computed normal-shift pay (shiftsScheduled × shiftRate) for SHIFT
  // employees. Always populated regardless of payType.
  basicSalary      Decimal @db.Decimal(12, 2)
  // Never used for SHIFT employees — kept only for MONTHLY employees who
  // may have a legitimate hourly-overtime arrangement. Extra shifts for
  // SHIFT employees use extraShiftPay below instead.
  overtime         Decimal @default(0) @db.Decimal(12, 2)
  bonuses          Decimal @default(0) @db.Decimal(12, 2)
  advances         Decimal @default(0) @db.Decimal(12, 2)
  otherAdjustments Decimal @default(0) @db.Decimal(12, 2)

  // Cached sums of the related PayrollAllowance / PayrollDeduction rows,
  // recalculated by the application layer — same cached-total pattern used
  // elsewhere in this schema (Invoice, PayrollRun).
  totalAllowances  Decimal @default(0) @db.Decimal(12, 2)
  totalDeductions  Decimal @default(0) @db.Decimal(12, 2)

  grossPay         Decimal @db.Decimal(12, 2)
  netPay           Decimal @db.Decimal(12, 2)

  paymentStatus    PayrollPaymentStatus @default(PENDING)

  // ---- Shift-based pay snapshot (SHIFT employees only; all null for MONTHLY) ----
  payType          PayType? // snapshot of the contract's payType at run time
  shiftsScheduled  Int?     // from the roster for this pay period
  shiftsCovered    Int?     // approved worked shifts, from Operations (Phase 3+)
  shiftsExtra      Int?     // approved extra shifts, from Operations (Phase 3+)
  shiftRate        Decimal? @db.Decimal(12, 2)
  extraShiftRate   Decimal? @db.Decimal(12, 2)
  normalShiftPay   Decimal? @db.Decimal(12, 2) // shiftsScheduled x shiftRate; mirrored into basicSalary
  extraShiftPay    Decimal? @db.Decimal(12, 2) // shiftsExtra x extraShiftRate; NOT "overtime"

  notes            String?
  dateCreated      DateTime @default(now())
  lastUpdated      DateTime @updatedAt

  allowances       PayrollAllowance[]
  deductions       PayrollDeduction[]

  // CURRENT_PERIOD salary advances auto-settled into this line item's
  // `advances` amount at generation time -- see SalaryAdvance above.
  settledSalaryAdvances SalaryAdvance[]

  // One line item per employee per run.
  @@unique([payrollRunId, employeeId])
  @@map("payroll_line_items")
}

model PayrollAllowance {
  id                String   @id @default(uuid())

  payrollLineItemId String
  payrollLineItem   PayrollLineItem @relation(fields: [payrollLineItemId], references: [id], onDelete: Cascade)

  allowanceTypeId   String
  allowanceType     AllowanceType @relation(fields: [allowanceTypeId], references: [id], onDelete: Restrict)

  amount            Decimal @db.Decimal(12, 2)
  notes             String?

  @@map("payroll_allowances")
}

model PayrollDeduction {
  id                String   @id @default(uuid())

  payrollLineItemId String
  payrollLineItem   PayrollLineItem @relation(fields: [payrollLineItemId], references: [id], onDelete: Cascade)

  deductionTypeId   String
  deductionType     DeductionType @relation(fields: [deductionTypeId], references: [id], onDelete: Restrict)

  // True for rows created/updated by POST .../apply-statutory-deductions,
  // false for anything a human entered by hand via the plain add-deduction
  // endpoint. Lets the auto-apply action safely update/replace its own
  // rows on re-run without ever touching a manually-entered deduction of
  // the same type.
  isStatutory       Boolean @default(false)

  amount            Decimal @db.Decimal(12, 2)
  notes             String?

  @@map("payroll_deductions")
}

// "What was changed, by whom, when" — kept as its own append-only table
// rather than fields on PayrollRun, since multiple edits can happen before
// finalization and management may want the full history, not just the
// latest actor at each stage.
model PayrollAuditLog {
  id           String   @id @default(uuid())

  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  action       String   // e.g. "CREATED", "STATUS_CHANGED", "LINE_ITEM_EDITED"
  performedBy  String
  performedAt  DateTime @default(now())
  details      String?  // free-text description of what changed

  @@map("payroll_audit_logs")
}

// ---------- OPERATIONS MODELS (Phase 1) ----------
// Phase 1 of the Operations/shift-payroll build: configurable shift types,
// per-site staffing requirements, and the roster (who is SUPPOSED to work).
// Daily attendance, coverage calculation, extra-shift recording, and the
// Operations-to-Payroll connection are Phase 2/3, not built yet — see
// PROJECT_HANDOFF.md. Building this in small verified phases, same as every
// other module in this project.

// Configurable, not hard-coded — a site might run Day/Night, or a different
// arrangement entirely. Same "don't hard-code business categories" approach
// already used for AllowanceType/DeductionType.
model ShiftType {
  id          String   @id @default(uuid())
  name        String   @unique // "Day", "Night", etc.
  isActive    Boolean  @default(true)
  dateCreated DateTime @default(now())
  lastUpdated DateTime @updatedAt

  siteRequirements SiteRequirement[]
  rosterEntries    RosterEntry[]
  operationsRecords OperationsRecord[]
  siteCoverages    SiteCoverage[]

  @@map("shift_types")
}

// "How many officers does this site need, for this shift type?" Has an
// effective date range so a requirement change doesn't rewrite history —
// same pattern as StatutoryRule.
model SiteRequirement {
  id               String    @id @default(uuid())

  siteId           String
  site             Site      @relation(fields: [siteId], references: [id], onDelete: Restrict)

  shiftTypeId      String
  shiftType        ShiftType @relation(fields: [shiftTypeId], references: [id], onDelete: Restrict)

  requiredOfficers Int

  effectiveFrom    DateTime  @default(now())
  effectiveTo      DateTime?

  notes            String?
  dateCreated      DateTime  @default(now())
  lastUpdated      DateTime  @updatedAt

  @@map("site_requirements")
}

// "Who is SUPPOSED to work?" — the roster. Answers a different question
// than Operations/Attendance (Phase 2), which answers "who ACTUALLY
// worked?"
model RosterEntry {
  id           String   @id @default(uuid())

  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  siteId       String
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Restrict)

  // Snapshot, not derived from site.clientId. A site's client assignment
  // can be reassigned later (the Sites API supports this) — historical
  // roster entries must not silently show a different client afterward.
  // Same snapshot principle already used throughout Payroll.
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)

  date         DateTime

  shiftTypeId  String
  shiftType    ShiftType @relation(fields: [shiftTypeId], references: [id], onDelete: Restrict)

  status       RosterEntryStatus @default(SCHEDULED)

  notes        String?
  dateCreated  DateTime @default(now())
  lastUpdated  DateTime @updatedAt

  attendanceRecords AttendanceRecord[]

  // One roster entry per employee, per site, per date, per shift type.
  @@unique([employeeId, siteId, date, shiftTypeId])
  @@map("roster_entries")
}

// ---------- OPERATIONS MODELS (Phase 3) ----------
// Phase 3: Daily Operations, Attendance, Coverage. Answers "who ACTUALLY
// worked?" (as opposed to Roster/Phase 1, which answers "who was SUPPOSED
// to work?"). See PROJECT_HANDOFF.md "Important Decisions" (2026-09-10)
// for the design reasoning behind this split.
//
// Design principle carried over from ContractStatus: required officers,
// scheduled officers, officers present/absent/on-leave, and coverage % are
// NEVER stored directly on these models — they are always CALCULATED by
// the application layer (required <- SiteRequirement, scheduled <-
// RosterEntry count, present/absent/etc <- AttendanceRecord counts,
// coverage % <- present/required). Storing them as separate fields would
// duplicate data that already exists elsewhere and could silently drift
// out of sync — the exact "duplicate functionality" the 2026-09-10 scope
// document's Section 37 warns against.

// One "daily site report" per site + date + shift type. The record itself
// holds only genuinely new information (issues/incidents/notes/review
// workflow) — everything else is derived, see comment above.
model OperationsRecord {
  id          String   @id @default(uuid())

  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Restrict)

  // Snapshot of the site's client at creation time — same reasoning as
  // RosterEntry.clientId (a site can be reassigned to a different client
  // later; historical operations records must not silently change which
  // client they show).
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)

  date        DateTime

  shiftTypeId String
  shiftType   ShiftType @relation(fields: [shiftTypeId], references: [id], onDelete: Restrict)

  siteIssues        String?
  incidents         String?
  // Added 2026-09-25, per explicit instruction: a plain "HH:MM" time
  // string for when the incident/issue described above actually
  // happened — `date` alone (the day) wasn't enough to say when during
  // the shift something occurred. Free text, not a DateTime, since it's
  // just a time-of-day label attached to the incidents/siteIssues text,
  // not a separate timestamped event log.
  incidentTime      String?
  operationalReport String?
  notes             String?

  // Free-text for now, consistent with PayrollRun.reviewedBy — no real
  // User table yet (see "Important Decisions", 2026-09-10).
  submittedBy  String?

  reviewStatus OperationsReviewStatus @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?

  dateCreated  DateTime @default(now())
  lastUpdated  DateTime @updatedAt

  attendanceRecords AttendanceRecord[]

  // One operations record per site, per date, per shift type — matches
  // the same granularity as RosterEntry.
  @@unique([siteId, date, shiftTypeId])
  @@map("operations_records")
}

// Per-employee attendance outcome for one OperationsRecord. Optionally
// linked to the RosterEntry it corresponds to — nullable because an
// EXTRA_SHIFT can be an employee who worked WITHOUT being pre-scheduled
// on the roster at all (walk-in coverage), which must still be recordable.
model AttendanceRecord {
  id                 String   @id @default(uuid())

  operationsRecordId String
  operationsRecord   OperationsRecord @relation(fields: [operationsRecordId], references: [id], onDelete: Cascade)

  employeeId         String
  employee           Employee @relation("AttendanceRecordEmployee", fields: [employeeId], references: [id], onDelete: Restrict)

  // Null if this attendance wasn't tied to a pre-existing roster entry
  // (e.g. an unscheduled extra shift). SetNull, not Restrict: the roster
  // entry itself can still be edited/cancelled independently later
  // without invalidating the historical attendance record.
  rosterEntryId      String?
  rosterEntry        RosterEntry? @relation(fields: [rosterEntryId], references: [id], onDelete: SetNull)

  status             AttendanceStatus

  // Used only when status = REPLACEMENT: which employee this person
  // covered for. Self-relation to Employee, per Section 39's explicit
  // "Officer A = Absent, Officer B = Replacement/Worked" test case.
  replacementForEmployeeId String?
  replacementForEmployee   Employee? @relation("AttendanceRecordReplacementFor", fields: [replacementForEmployeeId], references: [id], onDelete: SetNull)

  notes              String?
  dateCreated        DateTime @default(now())
  lastUpdated        DateTime @updatedAt

  // One attendance record per employee, per operations record.
  @@unique([operationsRecordId, employeeId])
  @@map("attendance_records")
}

// ---------- DEPARTMENT & TASK MODELS ----------

model Department {

  id               String       @id @default(uuid())
  name             String       @unique
  description      String?
  headOfDepartment String?
  status           RecordStatus @default(ACTIVE)
  dateCreated      DateTime     @default(now())
  lastUpdated      DateTime     @updatedAt
    users  User[]

  employees           Employee[]
  tasks               Task[]
  departmentRequests  DepartmentRequest[]
  generalExpenses     GeneralExpense[]
    inventoryItems       InventoryItem[]
  stockMovementsIssued StockMovement[]
  departmentBudgets    DepartmentBudget[]
  weeklyPlans          WeeklyPlan[]

  @@map("departments")
}

model Task {
  id           String     @id @default(uuid())
  title        String
  description  String?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  assignedToEmployeeId String?
  assignedToEmployee   Employee? @relation(fields: [assignedToEmployeeId], references: [id], onDelete: SetNull)

  assignedBy   String?
  dueDate      DateTime?
  priority     Priority   @default(NORMAL)
  status       TaskStatus @default(OPEN)
  completedAt  DateTime?
  notes        String?
  dateCreated  DateTime   @default(now())
  lastUpdated  DateTime   @updatedAt

  @@map("tasks")
}

model SiteCoverage {
  id            String   @id @default(uuid())

  siteId        String
  site          Site     @relation(fields: [siteId], references: [id], onDelete: Restrict)

  // One tick per site/date/shift — added 2026-09-21 to replace the earlier
  // single-tick-per-day design, which had no way to record Day and Night
  // coverage separately and silently let the second tick of the day
  // overwrite the first.
  shiftTypeId   String
  shiftType     ShiftType @relation(fields: [shiftTypeId], references: [id], onDelete: Restrict)

  date          DateTime
  isCovered     Boolean  @default(false)

  markedByUserId String?
  notes         String?

  dateCreated   DateTime @default(now())
  lastUpdated   DateTime @updatedAt

  @@unique([siteId, date, shiftTypeId])
  @@map("site_coverage")
}

model DepartmentRequest {
  id           String                  @id @default(uuid())

  departmentId String
  department   Department              @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  title        String
  description  String?
  priority     Priority                @default(NORMAL)
  status       DepartmentRequestStatus @default(PENDING)

  submittedBy   String?
  reviewedBy    String?
  reviewedAt    DateTime?
  estimatedCost Decimal? @db.Decimal(12, 2)
  notes         String?
  dateCreated   DateTime @default(now())
  lastUpdated   DateTime @updatedAt

  generalExpenses GeneralExpense[]

  @@map("department_requests")
}

model GeneralExpense {
  id                  String   @id @default(uuid())
  expenseDate         DateTime
  category            String
  amount              Decimal  @db.Decimal(12, 2)
  description         String?

  departmentId        String?
  department          Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  departmentRequestId String?
  departmentRequest   DepartmentRequest? @relation(fields: [departmentRequestId], references: [id], onDelete: SetNull)

  paidBy           String?
  approvedBy       String?
  receiptReference String?
  notes            String?
  dateCreated      DateTime @default(now())
  lastUpdated      DateTime @updatedAt

  @@map("general_expenses")
}

// Added 2026-09-25, per explicit instruction: Operations, out in the
// field, often collects cash or has a receipt in hand before the actual
// paperwork reaches Finance. This lets them log the receipt's reference
// number and amount on the spot, so that when the physical receipt is
// later handed in, Finance or Admin can reconcile it against what was
// already entered — catching a missing or altered receipt quickly,
// rather than trusting the paper trail alone.
enum FieldReceiptStatus {
  PENDING
  RECONCILED
  DISCREPANCY
}

model FieldReceiptEntry {
  id              String   @id @default(uuid())
  referenceNumber String
  amount          Decimal  @db.Decimal(12, 2)
  date            DateTime
  purpose         String?

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  recordedBy String? // free text, same pattern as OperationsRecord.submittedBy

  status               FieldReceiptStatus @default(PENDING)
  reconciledBy         String?
  reconciledAt         DateTime?
  reconciliationNotes  String?

  notes       String?
  dateCreated DateTime @default(now())
  lastUpdated DateTime @updatedAt

  @@map("field_receipt_entries")
}

// Added 2026-09-25, per the "Departmental Monthly Budgets" brief: lets a
// department prepare a planned monthly budget, submit it to Finance for
// review, and afterwards compare it against real spending. Deliberately
// modeled as its own module rather than folded into GeneralExpense/
// DepartmentRequest — a budget is a PLAN made before the fact, those two
// are records of what actually happened, and this module reads both of
// them at request-time (not stored, always live) to show budget vs actual.
enum BudgetStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  RETURNED
  REJECTED
}

model DepartmentBudget {
  id           String   @id @default(uuid())

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  // 1-12. Paired with year rather than a single DateTime — a budget covers
  // a whole calendar month, not a point in time, same reasoning as
  // PayrollRun.period elsewhere in this schema.
  month Int
  year  Int

  status BudgetStatus @default(DRAFT)

  preparedBy   String?
  submittedAt  DateTime?

  // Set by Finance/Management on any review action (UNDER_REVIEW, APPROVED,
  // RETURNED, REJECTED) — reused for all four rather than one field per
  // outcome, since only the latest review action ever matters.
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewComment String?

  notes       String?
  dateCreated DateTime @default(now())
  lastUpdated DateTime @updatedAt

  lines DepartmentBudgetLine[]

  // One budget per department per calendar month — "create October
  // Marketing budget" is meaningless twice over; copy-forward and manual
  // creation both go through the same uniqueness check.
  @@unique([departmentId, month, year])
  @@map("department_budgets")
}

model DepartmentBudgetLine {
  id       String @id @default(uuid())

  budgetId String
  budget   DepartmentBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  // Free text, matching GeneralExpense.category — actual-vs-budget for
  // this line is computed by matching this same text against
  // GeneralExpense.category for the same department or in the same month,
  // not a hard foreign key (both sides already use free-text categories
  // elsewhere in this schema, e.g. GeneralExpense/InventoryItem).
  category      String
  plannedAmount Decimal @db.Decimal(12, 2)
  description   String?

  dateCreated DateTime @default(now())
  lastUpdated DateTime @updatedAt

  @@map("department_budget_lines")
}

// Added 2026-09-25: a department's plan for ONE week — what it intends to
// do, not what it spent. Deliberately separate from DepartmentBudget (a
// month-level money plan) and from Task (an open-ended to-do with no week
// boundary): this is the weekly operational rhythm sitting between them.
// Each item carries an optional estimated cost so the week's intended
// spend can be read against the department's monthly budget, but nothing
// here is ever enforced against that budget — the comparison is shown for
// judgement, not used to block a plan (see weekly-plans.service.ts).
enum WeeklyPlanItemStatus {
  PLANNED
  DONE
  CANCELLED
}

model WeeklyPlan {
  id           String     @id @default(uuid())

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  // Always normalised to the Monday of the week (see startOfWeek() in
  // weekly-plans.validation.ts) so "the week of the 13th" is the same row
  // no matter which day inside it the user happened to pick.
  weekStartDate DateTime

  preparedBy   String?
  notes        String?
  dateCreated  DateTime   @default(now())
  lastUpdated  DateTime   @updatedAt

  items WeeklyPlanItem[]

  // One plan per department per week — same reasoning as
  // DepartmentBudget's per-month uniqueness.
  @@unique([departmentId, weekStartDate])
  @@map("weekly_plans")
}

model WeeklyPlanItem {
  id       String     @id @default(uuid())

  planId   String
  plan     WeeklyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  activity    String
  plannedDate DateTime
  responsible String?

  // Optional — plenty of planned activities cost nothing. Defaults to 0 so
  // the week's total is always summable without null handling.
  estimatedCost Decimal @default(0) @db.Decimal(12, 2)

  status WeeklyPlanItemStatus @default(PLANNED)
  notes  String?

  dateCreated DateTime @default(now())
  lastUpdated DateTime @updatedAt

  @@map("weekly_plan_items")
}

// ---------- INVENTORY & ASSETS ----------

enum ItemType {
  ASSET
  CONSUMABLE
}

enum ItemCondition {
  NEW
  GOOD
  FAIR
  POOR
  CONDEMNED
}

enum MovementType {
  PURCHASE
  ISSUE
  WRITE_OFF
  ADJUSTMENT
}

enum TakeHomeAction {
  TAKEN_HOME
  RETURNED
}

model InventoryItem {
  id              String        @id @default(uuid())
  name            String
  category        String
  itemType        ItemType
  quantity        Int           @default(0)
  unitOfMeasure   String?
  condition       ItemCondition @default(GOOD)
  serialNumber    String?
  purchaseDate    DateTime?
  purchasePrice   Decimal?      @db.Decimal(12, 2)

  assignedToEmployeeId   String?
  assignedToEmployee     Employee?   @relation(fields: [assignedToEmployeeId], references: [id], onDelete: SetNull)
  assignedToDepartmentId String?
  assignedToDepartment   Department? @relation(fields: [assignedToDepartmentId], references: [id], onDelete: SetNull)
  assignedToSiteId       String?
  assignedToSite         Site?       @relation(fields: [assignedToSiteId], references: [id], onDelete: SetNull)
  assignedAt             DateTime?

  canTakeHome  Boolean   @default(false)
  takenHome    Boolean   @default(false)
  takenHomeAt  DateTime?

  notes       String?
  status      RecordStatus @default(ACTIVE)
  dateCreated DateTime     @default(now())
  lastUpdated DateTime     @updatedAt

  stockMovements   StockMovement[]
  takeHomeLogs     ItemTakeHomeLog[]

  @@map("inventory_items")
}

model StockMovement {
  id              String        @id @default(uuid())

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  movementType    MovementType
  quantity        Int
  movementDate    DateTime

  issuedToDepartmentId String?
  issuedToDepartment   Department? @relation(fields: [issuedToDepartmentId], references: [id], onDelete: SetNull)
  issuedToEmployeeId   String?
  issuedToEmployee     Employee?   @relation(fields: [issuedToEmployeeId], references: [id], onDelete: SetNull)

  reference   String?
  notes       String?
  recordedBy  String?
  dateCreated DateTime @default(now())

  @@map("stock_movements")
}

model ItemTakeHomeLog {
  id              String        @id @default(uuid())

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  action        TakeHomeAction
  actionDate    DateTime
  authorisedBy  String?
  notes         String?
  dateCreated   DateTime @default(now())

  @@map("item_take_home_logs")
}

// ---------- USERS & AUTH (minimal scope — see PROJECT_HANDOFF.md) ----------
// Role is captured but NOT enforced per-module yet, except for User
// management itself (ADMIN only). Every other existing route just
// requires "logged in", nothing more, until real usage informs a
// proper permission matrix. Existing free-text actor fields elsewhere
// (PayrollRun.createdBy, OperationsRecord.submittedBy, etc.) are
// deliberately left as plain strings for now, not migrated to a real
// User relation — that's a separate, later decision, not bundled into
// this minimal auth rollout.

enum UserRole {
  ADMIN
  MANAGER
  PAYROLL
  OPERATIONS
  STAFF
  HR
  MARKETING
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         UserRole  @default(STAFF)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  dateCreated  DateTime  @default(now())
  lastUpdated  DateTime  @updatedAt
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])

  // Optional link to a specific Employee record, added for RBAC row-level
  // filtering ("my tasks", "my roster", future "My Payslips") - NOT every
  // User maps to an Employee (e.g. an office ADMIN account may not).
  // @unique because a given Employee should be claimed by at most one
  // User account.
  employeeId    String?   @unique
  employee      Employee? @relation(fields: [employeeId], references: [id])

  // Mobile push notifications — a user may have more than one device
  // (phone + tablet, or a reinstall that got a fresh token before the
  // old one expired).
  deviceTokens  DeviceToken[]

  // Marketing prospect/lead CRM — prospects this user is assigned to work,
  // and the stage-change history entries this user made on any prospect.
  assignedProspects    Prospect[]             @relation("ProspectAssignee")
  prospectStageChanges ProspectStageHistory[] @relation("ProspectStageChanger")
  marketingActivities  MarketingActivity[]    @relation("MarketingActivityPerformer")
  fieldVisits          FieldVisit[]           @relation("FieldVisitMarketer")
  marketingTargets     MarketingTarget[]      @relation("MarketingTargetMarketer")

  @@map("users")
}

// One row per mobile device registered for push notifications. A token
// always belongs to whichever user most recently registered it (see
// push-tokens.service.ts) rather than being permanently tied to one
// account, since the same phone can be used by different logged-in users
// over time.
model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  token      String   @unique
  platform   String   @default("android")
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @updatedAt

  @@index([userId])
  @@map("device_tokens")
}

// Tracks which alerts (from alerts.service.ts's live-calculated feed)
// have already triggered a push notification, keyed by the same
// (category, referenceId) pair alerts already use. A row is deleted once
// its alert's underlying issue is resolved, so a future recurrence
// notifies again instead of staying silent forever.
model SentAlertNotification {
  id          String   @id @default(uuid())
  category    String
  referenceId String
  severity    String
  sentAt      DateTime @default(now())

  @@unique([category, referenceId])
  @@map("sent_alert_notifications")
}
// ---------- SYSTEM SETTINGS ----------

model SystemSetting {
  id          String   @id @default(uuid())
  section     String   @unique
  value       Json
  updatedBy   String?
  dateCreated DateTime @default(now())
  lastUpdated DateTime @updatedAt

  @@map("system_settings")
}

// ---------- PAYROLL ENHANCEMENTS ----------

// Extended payroll profile per employee — bank details, statutory IDs,
// salary history. One record per employee, created on first payroll setup.
model EmployeePayrollProfile {
  id         String   @id @default(uuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  // Bank / payment details
  bankName      String?
  accountNumber String?
  branchName    String?
  mobileMoneyProvider String?
  mobileMoneyNumber   String?
  paymentMethod String? // BANK_TRANSFER | MOBILE_MONEY | CASH

  // Statutory IDs
  tpin        String?
  napsaNumber String?
  nhimaNumber String?
  nrcNumber   String?

  notes       String?
  dateCreated DateTime @default(now())
  lastUpdated DateTime @updatedAt

  salaryHistory SalaryHistory[]

  @@map("employee_payroll_profiles")
}

// Immutable log of every salary change — never updated, only appended.
model SalaryHistory {
  id        String   @id @default(uuid())
  profileId String
  profile   EmployeePayrollProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)

  previousSalary Decimal? @db.Decimal(12, 2)
  newSalary      Decimal  @db.Decimal(12, 2)
  effectiveDate  DateTime
  reason         String?
  changedBy      String?  // free-text for now
  approvedBy     String?
  dateCreated    DateTime @default(now())

  @@map("salary_history")
}

// Salary advance — short-term, repaid via monthly payroll deductions.
model SalaryAdvance {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  advanceDate      DateTime
  amount           Decimal  @db.Decimal(12, 2)
  reason           String?
  repaymentMonths  Int      // number of months to repay
  monthlyDeduction Decimal  @db.Decimal(12, 2)
  amountRepaid     Decimal  @default(0) @db.Decimal(12, 2)
  outstandingBalance Decimal @db.Decimal(12, 2) // updated on each deduction
  status           String   @default("ACTIVE") // ACTIVE | FULLY_REPAID | CANCELLED
  approvedBy       String?
  notes            String?
  dateCreated      DateTime @default(now())
  lastUpdated      DateTime @updatedAt

  // Added 2026-09-25 for the "boss pays a guard directly, before payroll
  // runs" case: CURRENT_PERIOD (default) is auto-settled by
  // payroll.service.ts the moment a run covering advanceDate's month is
  // generated -- it adds `amount` into that employee's PayrollLineItem
  // .advances and immediately marks this row FULLY_REPAID, so the
  // employee isn't shown owing/unpaid for wages already handed to them.
  // LOAN keeps the original manual, multi-month repayment behavior.
  advanceType SalaryAdvanceType @default(CURRENT_PERIOD)

  // Set once a payroll run's generation consumes this advance into a line
  // item, so re-generating/regenerating payroll never double-counts it.
  settledInPayrollLineItemId String?
  settledInPayrollLineItem   PayrollLineItem? @relation(fields: [settledInPayrollLineItemId], references: [id], onDelete: SetNull)

  @@map("salary_advances")
}

// Employee loan — longer-term, structured repayment.
model EmployeeLoan {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  loanAmount       Decimal  @db.Decimal(12, 2)
  dateIssued       DateTime
  monthlyRepayment Decimal  @db.Decimal(12, 2)
  numberOfInstallments Int
  amountPaid       Decimal  @default(0) @db.Decimal(12, 2)
  outstandingBalance Decimal @db.Decimal(12, 2)
  startDate        DateTime
  endDate          DateTime?
  status           String   @default("ACTIVE") // ACTIVE | FULLY_REPAID | DEFAULTED | CANCELLED
  approvedBy       String?
  notes            String?
  dateCreated      DateTime @default(now())
  lastUpdated      DateTime @updatedAt

  @@map("employee_loans")
}

// Structured payslip record — snapshot of earnings/deductions at run time.
// Immutable once created — historical payslips never change.
model PayslipRecord {
  id            String   @id @default(uuid())
  payrollRunId  String
  payrollRun    PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  lineItemId    String   @unique
  lineItem      PayrollLineItem @relation(fields: [lineItemId], references: [id], onDelete: Restrict)
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  // Snapshot fields — copied at generation time, never recalculated
  employeeName  String
  position      String?
  department    String?
  period        DateTime
  payslipNumber String   @unique

  basicSalary   Decimal  @db.Decimal(12, 2)
  shiftEarnings Decimal  @default(0) @db.Decimal(12, 2)
  // Per-type breakdown (e.g. [{"name":"Housing Allowance","amount":400}]),
  // snapshotted at generation time. Json rather than a relation to
  // AllowanceType so a historical payslip stays accurate even if an
  // allowance type is later renamed, deactivated, or deleted.
  allowanceBreakdown Json?
  allowances    Decimal  @default(0) @db.Decimal(12, 2)
  overtime      Decimal  @default(0) @db.Decimal(12, 2)
  bonuses       Decimal  @default(0) @db.Decimal(12, 2)
  otherEarnings Decimal  @default(0) @db.Decimal(12, 2)
  grossPay      Decimal  @db.Decimal(12, 2)

  paye          Decimal  @default(0) @db.Decimal(12, 2)
  napsa         Decimal  @default(0) @db.Decimal(12, 2)
  nhima         Decimal  @default(0) @db.Decimal(12, 2)
  loanDeduction Decimal  @default(0) @db.Decimal(12, 2)
  advanceDeduction Decimal @default(0) @db.Decimal(12, 2)
  otherDeductions Decimal @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal @db.Decimal(12, 2)
  netPay        Decimal  @db.Decimal(12, 2)

  // Employer-side statutory contributions (never deducted from the
  // employee) — computed from each StatutoryRule's employerRate at
  // generation time, same eligibility gating (napsaRegistered/
  // nhimaRegistered) as the employee-side deductions above.
  napsaEmployer Decimal  @default(0) @db.Decimal(12, 2)
  nhimaEmployer Decimal  @default(0) @db.Decimal(12, 2)
  totalEmployerContributions Decimal @default(0) @db.Decimal(12, 2)

  // Reference-info snapshots — copied from Employee/EmployeePayrollProfile
  // at generation time so a historical payslip stays accurate even if the
  // employee's record changes later.
  employeeNumber String?
  nrcNumber      String?
  napsaNumber    String?
  contractStartDate DateTime?
  // No leave-tracking module exists yet (no balance/accrual data anywhere
  // in the system), so this stays null until one is built — never
  // fabricated at generation time.
  leaveDaysTaken Int?

  paymentMethod String?
  paymentDate   DateTime?
  generatedAt   DateTime @default(now())

  @@map("payslip_records")
}

// ---------- MARKETING: PROSPECT / LEAD CRM ----------
// Phase 1 of the Marketing Department module (see the marketing brief) —
// a lightweight CRM so marketing staff can track prospects through a
// funnel from first contact to won/lost, independent of the Client model
// (a prospect only becomes a Client once actually won and set up as one —
// no automatic link is created here, that's a manual follow-on step for
// whoever converts them).

enum ProspectStage {
  NEW
  CONTACTED
  QUALIFIED
  MEETING
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  NOT_INTERESTED
}

model Prospect {
  id               String   @id @default(uuid())
  companyName      String
  contactName      String?
  contactPhone     String?
  contactEmail     String?
  location         String?
  potentialService String?
  source           String?

  assignedToId String?
  assignedTo   User?   @relation("ProspectAssignee", fields: [assignedToId], references: [id])

  dateAdded        DateTime  @default(now())
  lastContactDate  DateTime?
  nextFollowUpDate DateTime?

  stage            ProspectStage @default(NEW)
  opportunityValue Decimal?      @db.Decimal(12, 2)
  outcome          String?
  notes            String?

  lastUpdated DateTime @updatedAt

  stageHistory        ProspectStageHistory[]
  marketingActivities MarketingActivity[]
  fieldVisits         FieldVisit[]

  @@index([assignedToId])
  @@index([stage])
  @@index([nextFollowUpDate])
  @@map("prospects")
}

// Append-only log of every stage change — this is what the funnel/
// conversion-rate reporting (Phase 3 of the Marketing module) will read
// from, not just the prospect's current `stage` field, so history is
// never overwritten.
model ProspectStageHistory {
  id         String   @id @default(uuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  fromStage ProspectStage?
  toStage   ProspectStage
  notes     String?
  changedAt DateTime @default(now())

  changedById String?
  changedBy   User?   @relation("ProspectStageChanger", fields: [changedById], references: [id])

  @@index([prospectId])
  @@map("prospect_stage_history")
}

// ---------- MARKETING: ACTIVITY TRACKING ----------
// Phase 2 of the Marketing Department module. Deliberately generic enough
// to cover every activity type the brief lists (calls, emails, WhatsApp,
// meetings, proposals/quotations sent, social media, campaigns,
// networking) plus a lightweight VISIT entry — a fuller Field Visit
// Management module (location, photo, person visited) is a later,
// separate phase; this is not that, just the basic activity log an
// eventual Visit record can also show up in.
//
// An activity may reference a Prospect, an existing Client, or neither
// (e.g. general market research) — never required to have both, since a
// call to an existing client isn't a "prospect" activity.

enum MarketingActivityType {
  EMAIL
  CALL
  WHATSAPP
  VISIT
  MEETING
  FOLLOW_UP
  PROPOSAL_SENT
  QUOTATION_SENT
  NEW_PROSPECT_IDENTIFIED
  SOCIAL_MEDIA
  CAMPAIGN
  NETWORKING_EVENT
  OTHER
}

model MarketingActivity {
  id   String                @id @default(uuid())
  type MarketingActivityType

  prospectId String?
  prospect   Prospect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  purpose      String?
  outcome      String?
  nextAction   String?
  followUpDate DateTime?
  notes        String?

  activityDate DateTime @default(now())

  performedById String?
  performedBy   User?   @relation("MarketingActivityPerformer", fields: [performedById], references: [id])

  dateCreated DateTime @default(now())

  @@index([prospectId])
  @@index([clientId])
  @@index([performedById])
  @@index([activityDate])
  @@map("marketing_activities")
}

// ---------- MARKETING: FIELD VISIT MANAGEMENT ----------
// Phase 4 of the Marketing Department module. A richer, dedicated record
// for in-person visits (brief section 5) — location, person/company
// visited, opportunities identified, and an optional supporting photo/
// document — distinct from the generic MarketingActivity log (a VISIT
// activity type still exists there for a quick one-line mention; this is
// for the fuller record a real field visit report needs).
//
// attachmentFilename follows the exact same local-disk-upload pattern as
// Employee.photoFilename (see uploadMiddleware.ts / employees.service.ts)
// for consistency — including the same known limitation: if the backend's
// disk isn't backed by a persistent volume on its host (check Railway's
// volume config), an uploaded file can be lost on redeploy. Not fixed
// here since it's a pre-existing, shared limitation, not new to this
// feature — worth checking once file uploads start mattering for real
// records like this.
model FieldVisit {
  id String @id @default(uuid())

  prospectId String?
  prospect   Prospect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  visitDate               DateTime  @default(now())
  location                String?
  personVisited           String?
  purpose                 String?
  outcome                 String?
  opportunitiesIdentified String?
  nextAction              String?
  followUpDate            DateTime?
  notes                   String?

  attachmentFilename String?

  marketerId String?
  marketer   User?   @relation("FieldVisitMarketer", fields: [marketerId], references: [id])

  dateCreated DateTime @default(now())

  @@index([prospectId])
  @@index([clientId])
  @@index([marketerId])
  @@index([visitDate])
  @@map("field_visits")
}

// Marketing: Tasks & Targets — Phase 5 of the Marketing module. Tasks
// themselves reuse the existing generic Task model (departmentId lets a
// marketing task be filed under a "Marketing" department once one exists,
// per the brief's "reuse, don't rebuild" instruction). Targets are new:
// a lightweight monthly goal per marketer (or team-wide when marketerId
// is null), compared against actuals computed at read time from
// Prospect/MarketingActivity/FieldVisit/ProspectStageHistory — nothing
// duplicated or cached here, just the goal numbers themselves.
model MarketingTarget {
  id String @id @default(uuid())

  marketerId String?
  marketer   User?   @relation("MarketingTargetMarketer", fields: [marketerId], references: [id], onDelete: SetNull)

  periodYear  Int
  periodMonth Int // 1-12

  targetNewProspects Int?
  targetActivities   Int?
  targetVisits       Int?
  targetConversions  Int?
  notes              String?

  dateCreated DateTime @default(now())
  lastUpdated DateTime @updatedAt

  @@index([marketerId])
  @@index([periodYear, periodMonth])
  @@map("marketing_targets")
}
enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

// Quotations — formal price proposals sent to prospective or existing
// clients before an invoice is raised. quotationNumber is always
// auto-generated server-side (QUO-<year>-<0000>); the counter is stored
// in the "finance" settings section under quotationNumberSequences so an
// Admin can view or override it (e.g. to continue a manual sequence).
// Status workflow: DRAFT → SENT → ACCEPTED / REJECTED / EXPIRED.
// Only DRAFT quotations may be edited or deleted.
model Quotation {
  id               String          @id @default(uuid())
  quotationNumber  String          @unique

  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)

  siteId  String?
  site    Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  quotationDate  DateTime
  validUntil     DateTime?
  billingPeriod  String?

  amount  Decimal  @db.Decimal(12, 2)

  status  QuotationStatus  @default(DRAFT)
  notes   String?

  dateCreated  DateTime  @default(now())
  lastUpdated  DateTime  @updatedAt

  @@index([clientId])
  @@index([siteId])
  @@index([status])
  @@map("quotations")
}
