# Copy this file to .env and fill in your real values.
# Never commit the real .env file to Git.

# Replace YOUR_PASSWORD with the postgres password you set during installation.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/cms_db?schema=public"

PORT=3000
NODE_ENV=development

# Long random string used to sign login tokens — generate a fresh one for
# production (e.g. `openssl rand -base64 48`) and never reuse the local dev
# value.
JWT_SECRET=

# Comma-separated list of frontend URL(s) allowed to call this API.
# Leave unset for local dev (allows everything). Required in production,
# e.g. CORS_ORIGIN=https://cms.magensecurity.com
CORS_ORIGIN=

# Push notifications (Firebase Cloud Messaging) to the Android app. Get
# these from Firebase Console -> Project Settings -> Service Accounts ->
# Generate new private key (downloads a JSON file with these three
# fields). Leave all three blank to disable push notifications entirely —
# the server just skips sending, no error.
#
# FIREBASE_PRIVATE_KEY must keep its literal "\n" sequences (don't
# convert them to real line breaks) if your hosting platform's env-var UI
# stores everything as a single line — the app un-escapes them itself.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
