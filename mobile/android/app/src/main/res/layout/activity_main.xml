<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Splash overlay: shown until the CMS finishes its first page load,
         then faded out, mirroring the desktop app's splash screen. -->
    <LinearLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/magen_navy">

        <ImageView
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:src="@drawable/magen_security_logo"
            android:contentDescription="@string/app_name" />

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:indeterminateTint="@color/magen_green" />
    </LinearLayout>

    <!-- No-connection screen: shown when the CMS can't be reached, hidden
         otherwise. A stalled car (rocking side to side, with a warning
         badge and a puff of smoke drifting up) replaces the old plain
         alert icon, so a lost connection reads as "vehicle broken down"
         rather than a bare error message. -->
    <LinearLayout
        android:id="@+id/errorOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="@color/white"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp">

            <ImageView
                android:id="@+id/smokePuff"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|center_horizontal"
                android:src="@drawable/ic_smoke_puff"
                android:alpha="0"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/vehicleImage"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="bottom|center_horizontal"
                android:src="@drawable/ic_vehicle_breakdown"
                android:contentDescription="@string/no_connection_title" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|end"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_warning_badge"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/no_connection_title"
            android:textColor="@color/magen_navy"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/no_connection_message"
            android:textColor="@color/muted_text" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/magen_green"
            android:text="@string/retry"
            android:textColor="@color/white" />
    </LinearLayout>
</FrameLayout>
